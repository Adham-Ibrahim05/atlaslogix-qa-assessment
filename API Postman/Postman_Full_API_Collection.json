    {
      "name": "Audit Logs",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "const response = pm.response.json();\r",
              "\r",
              "pm.test(\"Response contains data array\", function () {\r",
              "    pm.expect(response.data).to.be.an(\"array\");\r",
              "});\r",
              "\r",
              "pm.test(\"Audit records exist\", function () {\r",
              "    pm.expect(response.data.length).to.be.above(0);\r",
              "});\r",
              "\r",
              "if (response.data.length > 0) {\r",
              "    pm.test(\"Audit record contains required fields\", function () {\r",
              "        const record = response.data[0];\r",
              "\r",
              "        pm.expect(record).to.have.property(\"entity\");\r",
              "        pm.expect(record).to.have.property(\"entity_id\");\r",
              "        pm.expect(record).to.have.property(\"field\");\r",
              "        pm.expect(record).to.have.property(\"before\");\r",
              "        pm.expect(record).to.have.property(\"after\");\r",
              "        pm.expect(record).to.have.property(\"changed_by\");\r",
              "        pm.expect(record).to.have.property(\"timestamp\");\r",
              "    });\r",
              "}"
            ],
            "type": "text/javascript",
            "packages": {}
          }
        }
      ],
