  "item": [
    {
      "name": "Auth - Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Login succeeded\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "var loginData = pm.response.json();",
              "",
              "pm.environment.set(\"token\", loginData.token);",
              "pm.environment.set(\"tenantId\", loginData.tenantId);",
              "pm.environment.set(\"userId\", loginData.userId);",
              "pm.environment.set(\"role\", loginData.role);",
              "",
              "pm.environment.set(",
              "    \"permissions\",",
              "    JSON.stringify(loginData.permissions || [])",
              ");",
              "",
              "pm.environment.set(",
              "    \"tenants\",",
              "    JSON.stringify(loginData.tenants || [])",
              ");",
              "",
              "var secondary = (loginData.tenants || []).find(function (item) {",
              "    return item.tenantId !== loginData.tenantId;",
              "});",
              "",
              "if (secondary) {",
              "    pm.environment.set(\"secondaryTenantId\", secondary.tenantId);",
              "}"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
