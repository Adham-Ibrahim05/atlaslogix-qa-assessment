  "info": {
    "_postman_id": "e6b05e14-510b-4771-9672-692acc162138",
    "name": "AtlasLogix QA Assessment API - Adham Ibrahim",
    "description": "Candidate collection for the isolated AtlasLogix multi-tenant frontend assessment environment. Run Auth - Login first; the collection stores the bearer token and accessible tenants automatically. Tenant administration requests require the supplied tenant-administrator account.",
