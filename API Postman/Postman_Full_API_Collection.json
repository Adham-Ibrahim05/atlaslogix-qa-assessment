    {
      "name": "Shipments - Compliance Approve",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const status = pm.response.code;\r",
              "\r",
              "pm.test(\"Approval request returns expected status\", function () {\r",
              "    pm.expect([200, 409]).to.include(status);\r",
              "});\r",
              "\r",
              "if (status == 200) {\r",
              "    const response = pm.response.json();\r",
              "\r",
              "    pm.test(\"Shipment ID exists\", function () {\r",
              "        pm.expect(response.shipmentId).to.exist;\r",
              "    });\r",
              "\r",
              "    pm.test(\"Compliance status is APPROVED\", function () {\r",
              "        pm.expect(response.compliance_status).to.eql(\"APPROVED\");\r",
              "    });\r",
              "}\r",
              "\r",
              "if (status == 409) {\r",
              "    pm.test(\"Repeated approval is rejected with 409\", function () {\r",
              "        pm.response.to.have.status(409);\r",
              "    });\r",
              "}"
            ],
            "type": "text/javascript",
            "packages": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
