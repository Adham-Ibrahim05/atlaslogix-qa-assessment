    {
      "name": "Shipments - Sensor History",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Sensor history succeeded', () => pm.response.to.have.status(200));",
              "const data = pm.response.json();",
              "pm.test('History contains chronological events', () => {",
              "  pm.expect(data.data).to.be.an('array');",
              "  for (let i = 1; i < data.data.length; i += 1) {",
              "    pm.expect(new Date(data.data[i].timestamp).getTime()).to.be.at.least(new Date(data.data[i - 1].timestamp).getTime());",
              "  }",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
