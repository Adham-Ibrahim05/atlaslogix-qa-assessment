    {
      "name": "Shipments - List",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Shipment list succeeded', () => pm.response.to.have.status(200));",
              "const results = pm.response.json().results || [];",
              "const pending = results.find(item => item.shipmentId.endsWith('-PENDING'));",
              "const approved = results.find(item => item.shipmentId.endsWith('-APPROVED'));",
              "const noData = results.find(item => item.shipmentId.endsWith('-NODATA'));",
              "const rejected = results.find(item => item.shipmentId.endsWith('-REJECTED'));",
              "if (pending) pm.collectionVariables.set('shipmentId', pending.shipmentId);",
              "if (approved) pm.collectionVariables.set('approvedShipmentId', approved.shipmentId);",
              "if (noData) pm.collectionVariables.set('noSensorShipmentId', noData.shipmentId);",
              "if (rejected) pm.collectionVariables.set('rejectedShipmentId', rejected.shipmentId);"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/tenants/{{tenantId}}/shipments?ordering=-last_updated",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "tenants",
            "{{tenantId}}",
            "shipments"
          ],
          "query": [
            {
              "key": "ordering",
              "value": "-last_updated"
            }
          ]
        }
      },
      "response": []
